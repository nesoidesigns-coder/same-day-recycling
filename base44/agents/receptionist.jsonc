      ]
    },
    {
      "function_name": "createBooking",
      "description": "Create a booking and instantly notify the owner. Pass {name, phone, address, items_description, city?, preferred_date?, time_window?, quote_estimate?, email?, description?}. Used for standard pickups, estate cleanouts, contractor debris, realtor jobs and FREE metal pickups."
    },
    {
      "function_name": "quoteEstimate",
      "description": "Instant price estimate for a junk load: pass {items}, {description}, or {image_urls: [photo URLs the customer sent]} - photos give the most accurate estimate. Returns a price range and truck-space label"
    },
    {
      "function_name": "rexSales",
      "description": "Complete a sale on an existing booking: {action:'payment_link', booking_id} returns {approve_url, amount} - a secure PayPal payment link to send the customer; {action:'receipt', booking_id} emails the customer their Recycling Impact Report (PDF receipt). Only works on bookings that exist."
    },
    {
      "function_name": "realtorLead",
      "description": "Save a realtor's contact details and property info when they ask about the partner program or request a cleanout quote/callback."
    },
