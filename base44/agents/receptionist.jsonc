    {
      "function_name": "rexGenerateMedia",
      "description": "Generate media on demand: {kind:'audio', text, voice?} renders a spoken MP3 (voices: river, honey, sunny, storm, spark); {kind:'video', prompt} renders a short 6-second AI video (site owner/admin only). Returns {url}."
    },
