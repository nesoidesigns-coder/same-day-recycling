{
  "name": "Facebook AI Auto Reply",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "facebook_ai_auto_reply",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_reply": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "facebookAutoReply",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "AI answers Messenger",
            "description": "Replies to new customer messages"
          }
        }
      }
    ]
  },
  "description": "Every 30 minutes: checks Messenger conversations and AI-answers new customer messages on the Facebook page"
}