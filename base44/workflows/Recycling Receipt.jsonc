{
  "name": "Recycling Receipt",
  "description": "Emails the customer a branded Recycling Receipt when their booking is marked completed",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Booking",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recycling_receipt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_receipt": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingReceipt",
            "args": {
              "booking_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email the Recycling Receipt",
            "description": "Branded impact receipt to the customer"
          }
        }
      }
    ]
  }
}