{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "RealtorLead",
      "events": [
        "create"
      ]
    }
  },
  "description": "When a realtor submits a cleanout request: AI estimates the load, prices it and drafts the reply, then emails the owner the full lead with the AI-drafted response",
  "name": "Realtor Lead AI",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "realtor_lead_ai",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_lead": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "realtorLeadAutoProcess",
            "args": {
              "lead_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "AI prices, drafts reply, emails owner",
            "description": "Estimates the load, quotes it, drafts the response and emails the owner"
          }
        }
      }
    ]
  }
}