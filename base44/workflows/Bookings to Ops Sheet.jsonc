{
  "name": "Bookings to Ops Sheet",
  "description": "Appends every new service request / booking to the operations Google Spreadsheet for the ops team.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Booking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "bookings_to_ops_sheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "push_booking_row": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "opsSheetsSync",
            "args": {
              "action": "process",
              "booking_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Append to ops sheet",
            "description": "New booking row into Google Sheets"
          }
        }
      }
    ]
  }
}