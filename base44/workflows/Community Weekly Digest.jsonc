{
  "name": "Community Weekly Digest",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "community_weekly_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "communityDigest",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly digest",
            "description": "Popular discussions + new guides to community members"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 4",
      "one_time_date": null,
      "timezone": "America/Vancouver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Emails community members a weekly digest of the most popular discussions and newly published library guides. Skips sending when there is not enough genuine content."
}