{
  "description": "Monthly research refresh of the scientifically-verified recycling statistics shown on the site",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 2 * *",
      "one_time_date": null,
      "timezone": "America/Vancouver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Recycling Facts Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recycling_facts_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_facts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingFactsSync"
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh recycling facts",
            "description": "Researches and updates cited statistics"
          }
        }
      }
    ]
  }
}