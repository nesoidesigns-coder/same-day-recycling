{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 18 * * *",
      "one_time_date": null,
      "timezone": "America/Vancouver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every day at 6pm Vancouver time, emails the owner a summary of all new bookings and realtor lead submissions from the past 24 hours",
  "name": "Daily Submissions Report",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_submissions_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_daily_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailySubmissionsReport",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Email daily report",
            "description": "New bookings and realtor leads of the day"
          }
        }
      }
    ]
  }
}