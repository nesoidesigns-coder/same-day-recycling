{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 1",
      "one_time_date": null,
      "timezone": "America/Vancouver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every Monday 6am, the AI researches recycling centers, depots and transfer stations in every active coverage city across Canada (in five sequential batches) from live web sources and refreshes the public map",
  "name": "Recycling Center Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recycling_center_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_batch_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingCenters",
            "args": {
              "action": "refresh",
              "cities": [
                "Vancouver",
                "Burnaby",
                "Surrey",
                "Richmond",
                "Coquitlam",
                "Victoria"
              ]
            }
          },
          "then": "sync_batch_2",
          "x-base44": {
            "title": "Research BC cities",
            "description": "Vancouver, Burnaby, Surrey, Richmond, Coquitlam, Victoria"
          }
        }
      },
      {
        "sync_batch_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingCenters",
            "args": {
              "action": "refresh",
              "cities": [
                "Kamloops",
                "Kelowna",
                "Maple Ridge",
                "Pitt Meadows",
                "Calgary",
                "Edmonton"
              ]
            }
          },
          "then": "sync_batch_3",
          "x-base44": {
            "title": "Research BC, AB cities",
            "description": "Kamloops, Kelowna, Maple Ridge, Pitt Meadows, Calgary, Edmonton"
          }
        }
      },
      {
        "sync_batch_3": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingCenters",
            "args": {
              "action": "refresh",
              "cities": [
                "Saskatoon",
                "Regina",
                "Winnipeg",
                "Toronto",
                "Ottawa",
                "Hamilton"
              ]
            }
          },
          "then": "sync_batch_4",
          "x-base44": {
            "title": "Research Prairies and ON cities",
            "description": "Saskatoon, Regina, Winnipeg, Toronto, Ottawa, Hamilton"
          }
        }
      },
      {
        "sync_batch_4": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingCenters",
            "args": {
              "action": "refresh",
              "cities": [
                "Mississauga",
                "Montreal",
                "Quebec City",
                "Moncton",
                "Saint John",
                "Halifax"
              ]
            }
          },
          "then": "sync_batch_5",
          "x-base44": {
            "title": "Research ON, QC, Atlantic cities",
            "description": "Mississauga, Montreal, Quebec City, Moncton, Saint John, Halifax"
          }
        }
      },
      {
        "sync_batch_5": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recyclingCenters",
            "args": {
              "action": "refresh",
              "cities": [
                "Charlottetown",
                "St. John's",
                "Whitehorse",
                "Yellowknife",
                "Iqaluit"
              ]
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Research Atlantic and North cities",
            "description": "Charlottetown, St. John's, Whitehorse, Yellowknife, Iqaluit"
          }
        }
      }
    ]
  }
}