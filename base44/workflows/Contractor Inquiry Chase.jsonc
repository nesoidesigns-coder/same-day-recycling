{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "ContractorApplication",
      "events": [
        "create"
      ]
    }
  },
  "description": "The moment a contractor applies, the AI drafts a warm acknowledgment, emails it instantly and alerts the owner with the draft",
  "name": "Contractor Inquiry Chase",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contractor_inquiry_chase",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "chase_lead": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "leadChase",
            "args": {
              "kind": "contractor_application",
              "id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "AI chases the contractor application",
            "description": "Instant personalized acknowledgment email + owner alert"
          }
        }
      }
    ]
  }
}