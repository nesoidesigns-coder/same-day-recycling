{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "ContractorApplication",
      "events": [
        "create"
      ]
    }
  },
  "description": "The moment a contractor applies, a branded confirmation email is sent to the applicant and the owner is alerted",
  "name": "Contractor Inquiry Chase",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contractor_inquiry_chase",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "confirm_application": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "applicationNotify",
            "args": {
              "action": "received",
              "id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Confirm application by email",
            "description": "Branded confirmation to the applicant + owner alert"
          }
        }
      }
    ]
  }
}