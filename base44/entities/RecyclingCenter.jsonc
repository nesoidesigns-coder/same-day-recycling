{
  "name": "RecyclingCenter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "province_code": {
      "type": "string",
      "default": "",
      "description": "Province or territory code (BC, ON, QC, NT...) for national filtering."
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "website": {
      "type": "string",
      "default": ""
    },
    "accepts": {
      "type": "string",
      "default": ""
    },
    "restrictions": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Materials or conditions the facility refuses (e.g. no propane tanks). Empty = not confirmed."
    },
    "operating_hours": {
      "type": "string",
      "default": "",
      "maxLength": 500,
      "description": "Confirmed operating hours, e.g. 'Mon-Sat 8am-4pm'. Empty = not confirmed."
    },
    "fees": {
      "type": "string",
      "default": "",
      "maxLength": 500,
      "description": "Confirmed drop-off fees, as published by the facility. Empty = not confirmed."
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "default": "",
      "description": "Public source (municipal page or facility website) the details were taken from."
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "Date the details were last verified against the source. Displayed to users \u2014 never invented."
    },
    "note": {
      "type": "string",
      "default": ""
    },
    "researched_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "city",
    "lat",
    "lng"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}