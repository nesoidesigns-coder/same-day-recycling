{
  "name": "AiActionLog",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string",
      "enum": [
        "rex",
        "admin",
        "system"
      ],
      "default": "rex",
      "description": "Who performed the action."
    },
    "action": {
      "type": "string",
      "maxLength": 100,
      "description": "Short machine name of the action, e.g. quote_generated, booking_created, payment_link_sent, receipt_sent, refund_issued, status_updated, change_order_created, dispute_logged."
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "description": "One factual sentence: what the AI did and why. Visible in the admin Rex AI monitor."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "escalated",
        "pending"
      ],
      "default": "success",
      "description": "escalated = Rex referred the case to a human (dispute, unusual financial activity, refund request)."
    },
    "target_type": {
      "type": "string",
      "default": "",
      "description": "booking, quote, dispute, payment or other."
    },
    "target_id": {
      "type": "string",
      "default": "",
      "description": "Id of the record the action acted on."
    }
  },
  "required": [
    "action",
    "summary"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}