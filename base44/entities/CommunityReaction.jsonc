{
  "name": "CommunityReaction",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "post",
        "comment"
      ],
      "default": "post"
    },
    "target_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "helpful"
      ],
      "default": "helpful"
    },
    "owner_email": {
      "type": "string",
      "maxLength": 200,
      "description": "The reacting member's account email, set at creation."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Optional free-text description of this record for admin reference."
    }
  },
  "required": [
    "target_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}