{
  "name": "IndustryNode",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "maxLength": 80,
      "description": "Stable identifier of this industry, subdivision or search topic."
    },
    "level": {
      "type": "string",
      "enum": [
        "industry",
        "subdivision",
        "topic"
      ],
      "description": "Ring level in the national demand gauge: outer = industry, middle = subdivision, inner = topic."
    },
    "parent_slug": {
      "type": "string",
      "default": "",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "Customer-readable label shown on the gauge and detail cards."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Search expressions used to match real observations and platform records to this topic. Never invented demand \u2014 only matching keys."
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order within its parent."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Optional free-text description of this record for admin reference."
    }
  },
  "required": [
    "slug",
    "level",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}