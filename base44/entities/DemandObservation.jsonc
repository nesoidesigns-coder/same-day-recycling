{
  "name": "DemandObservation",
  "type": "object",
  "properties": {
    "geo_type": {
      "type": "string",
      "enum": [
        "national",
        "province",
        "city"
      ],
      "default": "province"
    },
    "geo_key": {
      "type": "string",
      "default": "",
      "description": "CA, province code, or source-reported city identifier."
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "country_code": {
      "type": "string",
      "default": "CA"
    },
    "search_engine": {
      "type": "string",
      "enum": [
        "google",
        "bing",
        "other",
        "unknown"
      ],
      "default": "unknown"
    },
    "provider": {
      "type": "string",
      "enum": [
        "keyword_planner",
        "dataforseo",
        "semrush",
        "google_trends",
        "licensed_import",
        "manual"
      ],
      "default": "manual"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "junk_removal",
        "furniture_removal",
        "appliance_removal",
        "electronics",
        "recycling",
        "waste_disposal",
        "estate_cleanout",
        "construction_debris",
        "demolition_cleanup",
        "mattress_disposal",
        "yard_waste_removal",
        "commercial_waste",
        "hot_tub_removal",
        "scrap_metal",
        "bin_rentals",
        "same_day_pickup",
        "other"
      ],
      "default": "other"
    },
    "keyword": {
      "type": "string",
      "description": "Source canonical keyword. Provider-grouped close variants are not additional searches."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Optional short description of this observation."
    },
    "close_variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "period": {
      "type": "string",
      "description": "YYYY-MM of source reporting period, never substituted with retrieval month."
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "monthly_volume",
        "monthly_average",
        "relative_interest",
        "estimated_organic_clicks",
        "estimated_paid_clicks",
        "unspecified_estimate"
      ],
      "default": "unspecified_estimate"
    },
    "period_start": {
      "type": "string",
      "default": ""
    },
    "period_end": {
      "type": "string",
      "default": ""
    },
    "est_monthly_volume": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "estimated_clicks": {
      "type": "number",
      "minimum": 0,
      "description": "Provider-reported industry-wide click estimate, never inferred from volume, CPC or site traffic."
    },
    "volume_basis": {
      "type": "string",
      "enum": [
        "keyword_planner",
        "dataforseo",
        "semrush",
        "google_trends",
        "published_estimate",
        "admin_import",
        "not_available"
      ],
      "default": "admin_import"
    },
    "trend_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "comparison_group": {
      "type": "string",
      "default": "",
      "description": "Source export normalization window. Trends indices are comparable only within this window and geography."
    },
    "trend_direction": {
      "type": "string",
      "enum": [
        "rising",
        "steady",
        "falling",
        "unknown"
      ],
      "default": "unknown"
    },
    "competition": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "default": "unknown",
      "description": "Ad competition, not organic difficulty or contractor supply."
    },
    "source": {
      "type": "string",
      "default": ""
    },
    "source_url": {
      "type": "string",
      "default": ""
    },
    "methodology_note": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "update_cadence": {
      "type": "string",
      "default": "",
      "maxLength": 200
    },
    "retrieved_at": {
      "type": "string",
      "default": "",
      "description": "Actual dataset retrieval/import timestamp, not the reporting period."
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "keyword"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}