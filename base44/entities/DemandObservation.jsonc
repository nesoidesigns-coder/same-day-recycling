{
  "name": "DemandObservation",
  "type": "object",
  "properties": {
    "geo_type": {
      "type": "string",
      "enum": [
        "national",
        "province",
        "city"
      ],
      "default": "province"
    },
    "geo_key": {
      "type": "string",
      "default": "",
      "description": "CA, province code or source-reported city identifier."
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "service_category": {
      "type": "string",
      "enum": [
        "junk_removal",
        "furniture_removal",
        "appliance_removal",
        "electronics",
        "recycling",
        "waste_disposal",
        "estate_cleanout",
        "construction_debris",
        "demolition_cleanup",
        "mattress_disposal",
        "yard_waste_removal",
        "commercial_waste",
        "hot_tub_removal",
        "scrap_metal",
        "bin_rentals",
        "same_day_pickup",
        "other"
      ],
      "default": "other"
    },
    "keyword": {
      "type": "string",
      "description": "Source-reported canonical keyword; combined variants are not separate volume records."
    },
    "close_variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Variants included in this keyword's reported volume, not additional searches."
    },
    "period": {
      "type": "string",
      "description": "YYYY-MM of the source observation, not the retrieval month."
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "monthly_volume",
        "monthly_average",
        "relative_interest",
        "unspecified_estimate"
      ],
      "default": "unspecified_estimate",
      "description": "Monthly estimates, rolling averages and Trends samples are never combined or compared interchangeably."
    },
    "period_start": {
      "type": "string",
      "default": "",
      "description": "Source reporting window start (YYYY-MM-DD or YYYY-MM)."
    },
    "period_end": {
      "type": "string",
      "default": "",
      "description": "Source reporting window end."
    },
    "est_monthly_volume": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "volume_basis": {
      "type": "string",
      "enum": [
        "keyword_planner",
        "google_trends",
        "published_estimate",
        "admin_import",
        "not_available"
      ],
      "default": "admin_import"
    },
    "trend_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "Google Trends export's sampled relative-interest index, never a search count."
    },
    "comparison_group": {
      "type": "string",
      "default": "",
      "description": "Stable source export window id. Trends indices are only compared inside this window and geography."
    },
    "trend_direction": {
      "type": "string",
      "enum": [
        "rising",
        "steady",
        "falling",
        "unknown"
      ],
      "default": "unknown"
    },
    "competition": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "default": "unknown",
      "description": "Advertising competition, not contractor supply or SEO difficulty."
    },
    "source": {
      "type": "string",
      "default": ""
    },
    "source_url": {
      "type": "string",
      "default": ""
    },
    "methodology_note": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Retrieval date, distinct from the reporting period."
    }
  },
  "required": [
    "keyword"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}