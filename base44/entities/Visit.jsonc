{
  "name": "Visit",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "facebook",
        "search",
        "direct",
        "other"
      ],
      "default": "direct"
    },
    "path": {
      "type": "string",
      "default": "/"
    },
    "referrer": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}