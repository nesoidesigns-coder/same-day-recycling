{
  "name": "Visit",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "facebook",
        "search",
        "direct",
        "ai_search",
        "google_business",
        "other"
      ],
      "default": "direct",
      "description": "google_business = the visit arrived from the Google Business Profile or a Maps listing (referrer), or via a link tagged ?src=gbp."
    },
    "path": {
      "type": "string",
      "default": "/"
    },
    "referrer": {
      "type": "string",
      "default": ""
    },
    "traffic_class": {
      "type": "string",
      "enum": [
        "customer",
        "contractor",
        "owner",
        "bot"
      ],
      "default": "customer",
      "description": "Who the visit is: customer = exploring services and requesting quotes; contractor = providers exploring partnerships and software; owner = the admin's own testing and administration; bot = automated crawlers and suspicious requests. Conversions are measured on real (customer + contractor) traffic only."
    },
    "sid": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Anonymous browser-session key linking this visit to a later quote request or booking in the same session. No cookies, no personal data."
    },
    "country": {
      "type": "string",
      "enum": [
        "CA",
        "other"
      ],
      "default": "CA",
      "description": "Coarse visitor country inferred from device timezone (CA or other). Not precise geolocation."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}