{
  "name": "Visit",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "facebook",
        "search",
        "direct",
        "ai_search",
        "google_business",
        "other"
      ],
      "default": "direct",
      "description": "Legacy coarse attribution, kept for historical compatibility. Detailed attribution lives in `channel`."
    },
    "channel": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Detailed acquisition channel assigned from recorded evidence (UTM tags or referrer): google_organic, bing_organic, other_search, facebook, instagram, other_social, ai_referral, direct, referral, paid, google_business. Empty on historical records; dashboards re-derive it from the stored referrer without rewriting records."
    },
    "utm_source": {
      "type": "string",
      "default": "",
      "maxLength": 80,
      "description": "utm_source captured from the landing URL, when the link was campaign-tagged."
    },
    "utm_medium": {
      "type": "string",
      "default": "",
      "maxLength": 80,
      "description": "utm_medium captured from the landing URL, when the link was campaign-tagged."
    },
    "utm_campaign": {
      "type": "string",
      "default": "",
      "maxLength": 120,
      "description": "utm_campaign captured from the landing URL, when the link was campaign-tagged."
    },
    "path": {
      "type": "string",
      "default": "/"
    },
    "referrer": {
      "type": "string",
      "default": ""
    },
    "traffic_class": {
      "type": "string",
      "enum": [
        "customer",
        "contractor",
        "owner",
        "bot"
      ],
      "default": "customer",
      "description": "Who the visit is: customer = exploring services and requesting quotes; contractor = providers exploring partnerships and software; owner = the admin's own testing and administration; bot = automated crawlers and suspicious requests. Conversions are measured on real (customer + contractor) traffic only."
    },
    "sid": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Anonymous browser-session key linking this visit to a later quote request or booking in the same session. No cookies, no personal data. Records without one are legacy pageviews from before session tracking existed and are labeled as such, never rewritten."
    },
    "country": {
      "type": "string",
      "enum": [
        "CA",
        "other"
      ],
      "default": "CA",
      "description": "Coarse visitor country inferred from device timezone (CA or other). Not precise geolocation."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}