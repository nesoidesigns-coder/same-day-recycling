{
  "name": "Visit",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "facebook",
        "search",
        "direct",
        "ai_search",
        "other"
      ],
      "default": "direct"
    },
    "path": {
      "type": "string",
      "default": "/"
    },
    "referrer": {
      "type": "string",
      "default": ""
    },
    "traffic_class": {
      "type": "string",
      "enum": [
        "customer",
        "contractor",
        "owner",
        "bot"
      ],
      "default": "customer",
      "description": "Who the visit is: customer = exploring services and requesting quotes; contractor = providers exploring partnerships and software; owner = the admin's own testing and administration; bot = automated crawlers and suspicious requests. Conversions are measured on real (customer + contractor) traffic only."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}