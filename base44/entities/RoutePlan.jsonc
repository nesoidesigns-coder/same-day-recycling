{
  "name": "RoutePlan",
  "type": "object",
  "properties": {
    "plan_date": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "stop_count": {
      "type": "number",
      "default": 0
    },
    "cluster_count": {
      "type": "number",
      "default": 0
    },
    "total_km": {
      "type": "number",
      "default": 0
    },
    "unoptimized_km": {
      "type": "number",
      "default": 0
    },
    "saved_km": {
      "type": "number",
      "default": 0
    },
    "unmatched_count": {
      "type": "number",
      "default": 0
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}