{
  "name": "QuoteLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "items_text": {
      "type": "string",
      "default": ""
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "description": "Public URL of the customer's photo, when the quote flow captured one."
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "estimate": {
      "type": "string",
      "default": ""
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "booked",
        "lost"
      ],
      "default": "new"
    },
    "sid": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Anonymous browser-session key linking this quote request to its originating visit (traffic source, country, service viewed) and any booking in the same session."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}