{
  "name": "RealtorLead",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "brokerage": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "property_address": {
      "type": "string"
    },
    "items_description": {
      "type": "string",
      "default": ""
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "booked",
        "closed"
      ],
      "default": "new"
    },
    "load_label": {
      "type": "string",
      "default": ""
    },
    "quote_low": {
      "type": "number"
    },
    "quote_high": {
      "type": "number"
    },
    "ai_reply": {
      "type": "string",
      "default": ""
    },
    "ai_processed": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "agent_name",
    "email",
    "phone",
    "property_address"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}