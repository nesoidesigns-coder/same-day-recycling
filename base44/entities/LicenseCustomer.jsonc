{
  "name": "LicenseCustomer",
  "type": "object",
  "properties": {
    "license_email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "notes": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "license_email",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}