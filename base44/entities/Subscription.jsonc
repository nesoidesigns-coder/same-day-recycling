{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "default": "$299/month \u2014 up to 4 pickups"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "company",
    "name",
    "email",
    "phone"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}