{
  "name": "CityRules",
  "type": "object",
  "properties": {
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string",
      "default": ""
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "donation_programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "accepts": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "source_note": {
      "type": "string",
      "default": "",
      "maxLength": 500
    },
    "generated_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "city"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}