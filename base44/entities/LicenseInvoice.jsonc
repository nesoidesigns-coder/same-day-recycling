{
  "name": "LicenseInvoice",
  "type": "object",
  "properties": {
    "license_email": {
      "type": "string"
    },
    "pickup_id": {
      "type": "string",
      "default": ""
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "default": ""
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "void"
      ],
      "default": "draft"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "license_email",
    "customer_name",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.license_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}