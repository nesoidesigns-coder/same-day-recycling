{
  "name": "DemandSnapshot",
  "type": "object",
  "properties": {
    "capture": {
      "type": "object",
      "default": {},
      "description": "Private verified company aggregates: Search Console visibility, Analytics engagement and Recycling OS inquiries and jobs. Never nationwide market demand."
    },
    "refreshed_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful company performance refresh."
    },
    "sources": {
      "type": "object",
      "default": {},
      "description": "Private per-source refresh status and notes."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}