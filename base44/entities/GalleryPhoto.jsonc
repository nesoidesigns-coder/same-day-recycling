{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "enum": [
        "trucks",
        "crew",
        "jobsites"
      ],
      "default": "trucks"
    },
    "file_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}