{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "enum": [
        "trucks",
        "crew",
        "jobsites"
      ],
      "default": "trucks"
    },
    "photo_type": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ],
      "description": "Set to 'before' or 'after' to show the photo as a Before/After pair on a service page; leave unset for standard gallery photos."
    },
    "service": {
      "type": "string",
      "default": "",
      "description": "Slug of the service page this photo belongs to (e.g. furniture-removal, appliance-removal). Empty means gallery-only."
    },
    "file_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "provenance": {
      "type": "string",
      "enum": [
        "verified_job",
        "illustrative_ai",
        "stock_photo",
        "unverified"
      ],
      "default": "unverified",
      "description": "Where this image came from. verified_job = an actual completed job, shown with the customer's permission. illustrative_ai = AI-generated, used to illustrate the service and never presented as a real job. stock_photo = licensed stock photography. unverified = not yet confirmed and must be reviewed before being presented as a real job."
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}