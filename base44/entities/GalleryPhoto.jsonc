{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "enum": [
        "trucks",
        "crew",
        "jobsites"
      ],
      "default": "trucks"
    },
    "photo_type": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ],
      "description": "Set to 'before' or 'after' to show the photo as a Before/After pair on a service page; leave unset for standard gallery photos."
    },
    "service": {
      "type": "string",
      "default": "",
      "description": "Slug of the service page this photo belongs to (e.g. furniture-removal, appliance-removal). Empty means gallery-only."
    },
    "file_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}