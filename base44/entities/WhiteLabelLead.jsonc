{
  "name": "WhiteLabelLead",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "fleet_size": {
      "type": "number",
      "default": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "custom_branding",
        "full_app",
        "lead_gen"
      ],
      "default": "custom_branding"
    },
    "message": {
      "type": "string",
      "default": ""
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "proposal_sent",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "company",
    "contact_name",
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}