{
  "name": "BrandScan",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "default": "samedayrecycling.ca"
    },
    "overall_score": {
      "type": "number"
    },
    "scores": {
      "type": "object",
      "default": {},
      "description": "Per-dimension sub-scores: {seo, discoverability, reputation, credibility, positioning}, each {score, explanation, basis: verified|ai_estimate}."
    },
    "methodology": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "The scoring formula recorded at scan time (weights, evidence requirements, version). A methodology change is recorded here so score movements are explainable even when the site itself didn't change."
    },
    "measured_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {},
          "window": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Directly measured search performance and business facts (GSC clicks/impressions/position, approved review count, verified contractor coverage). Always kept separate from AI-estimated scores."
    },
    "score_change_explanation": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Why the overall score moved since the previous scan: which dimensions changed, methodology changes, or measured-signal movements."
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verified_findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Findings confirmed against fetched live content ({finding, evidence})."
    },
    "ai_estimates": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Findings the AI could not verify against fetched content ({finding, reasoning})."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs actually fetched for this scan, with fetch outcome per source."
    },
    "summary": {
      "type": "string",
      "maxLength": 3000
    },
    "previous_overall_score": {
      "type": "number",
      "description": "Overall score of the scan immediately before this one, for trend comparison. Null on the first scan."
    },
    "run_by": {
      "type": "string",
      "default": ""
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}