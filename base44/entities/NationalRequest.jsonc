{
  "name": "NationalRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string"
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "postal_code": {
      "type": "string",
      "default": ""
    },
    "service_type": {
      "type": "string",
      "enum": [
        "junk_removal",
        "furniture",
        "appliances",
        "electronics",
        "metal_pickup",
        "cleanouts",
        "other"
      ],
      "default": "junk_removal"
    },
    "items_description": {
      "type": "string",
      "maxLength": 1000
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "record_type": {
      "type": "string",
      "enum": [
        "service",
        "internal_test"
      ],
      "default": "service",
      "description": "internal_test = validation fixture. Test records are excluded from public coverage counts (matching_cities) and never count as real demand."
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "verified",
        "onboarding",
        "unverified"
      ],
      "default": "unverified"
    },
    "partner_id": {
      "type": "string",
      "default": ""
    },
    "partner_name": {
      "type": "string",
      "default": ""
    },
    "recruitment_id": {
      "type": "string",
      "default": ""
    },
    "dispatch_task_id": {
      "type": "string",
      "default": ""
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "awaiting_contractor",
        "contractor_contacted",
        "contractor_accepted",
        "pickup_scheduled",
        "job_completed",
        "unable_to_fulfill"
      ],
      "default": "awaiting_contractor"
    },
    "contacted_contractor": {
      "type": "string",
      "default": "",
      "maxLength": 200
    },
    "dispatch_contact_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "quote_amount": {
      "type": "number"
    },
    "quote_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_provider",
        "sent",
        "approved",
        "declined"
      ],
      "default": "none"
    },
    "appointment_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "provider_matching",
        "recruiting",
        "matched",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "reference_code": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "name",
    "phone",
    "city",
    "service_type",
    "items_description"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}