{
  "name": "SmsMessage",
  "type": "object",
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound",
      "description": "inbound = received from a customer or contractor; outbound = sent by the platform, Rex or an admin."
    },
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "contractor",
        "admin",
        "rex",
        "system"
      ],
      "default": "system",
      "description": "Who sent the message."
    },
    "phone": {
      "type": "string",
      "description": "The other party's phone number in E.164 format (e.g. +16045551234)."
    },
    "body": {
      "type": "string",
      "maxLength": 1600,
      "description": "The message text."
    },
    "booking_id": {
      "type": "string",
      "default": "",
      "description": "Booking this message relates to, when matched."
    },
    "partner_id": {
      "type": "string",
      "default": "",
      "description": "Partner (contractor) this message relates to, when matched."
    },
    "twilio_sid": {
      "type": "string",
      "default": "",
      "description": "Twilio message SID for outbound sends."
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "received"
      ],
      "default": "sent"
    },
    "error": {
      "type": "string",
      "default": "",
      "maxLength": 500,
      "description": "Failure reason when status is failed."
    }
  },
  "required": [
    "direction",
    "phone",
    "body"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}