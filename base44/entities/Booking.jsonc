{
  "name": "Booking",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "items_description": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "time_window": {
      "type": "string"
    },
    "quote_estimate": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string",
      "format": "uri"
    },
    "curbside_discount": {
      "type": "boolean",
      "default": false
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "record_type": {
      "type": "string",
      "enum": [
        "service",
        "internal_test"
      ],
      "default": "service"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "none",
        "paid",
        "refunded"
      ],
      "default": "none"
    },
    "notified": {
      "type": "object",
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "contacted",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "reference_code": {
      "type": "string",
      "default": "",
      "description": "8-character public tracking code shown to the customer for status lookup."
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "accepted",
        "scheduled",
        "completed",
        "declined",
        "paid"
      ],
      "default": "unassigned"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "job_value": {
      "type": "number"
    },
    "final_invoice": {
      "type": "number",
      "default": 0
    },
    "referred_by_admin": {
      "type": "boolean",
      "default": false
    },
    "commission_rate": {
      "type": "number",
      "default": 0
    },
    "commission_earned": {
      "type": "number",
      "default": 0
    },
    "commission_paid": {
      "type": "number",
      "default": 0
    },
    "commission_paid_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_confirmed": {
      "type": "boolean",
      "default": false
    },
    "payout_paid": {
      "type": "boolean",
      "default": false
    },
    "review_requested": {
      "type": "boolean",
      "default": false
    },
    "calendar_event_id": {
      "type": "string",
      "default": ""
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "customer_origin_source": {
      "type": "string",
      "enum": [
        "contractor_generated",
        "platform_generated",
        "personal_referral",
        "other_referral"
      ],
      "description": "How the customer was FIRST acquired. Set once, never rewritten."
    },
    "job_source": {
      "type": "string",
      "enum": [
        "contractor_generated",
        "platform_generated",
        "personal_referral",
        "repeat_customer",
        "other_referral"
      ],
      "description": "Where THIS job came from (can differ from the customer's original source)."
    },
    "agreement_id": {
      "type": "string",
      "default": "",
      "description": "ContractorAgreement applied to this job at assignment time."
    },
    "fee_terms_snapshot": {
      "type": "object",
      "default": {},
      "description": "Fee terms disclosed to the contractor when the job was assigned."
    },
    "platform_fee_amount": {
      "type": "number",
      "default": 0
    },
    "contractor_net_amount": {
      "type": "number",
      "default": 0
    },
    "refund_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "phone",
    "address",
    "items_description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}