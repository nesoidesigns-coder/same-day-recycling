{
  "name": "Booking",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "items_description": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "time_window": {
      "type": "string"
    },
    "quote_estimate": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string",
      "format": "uri"
    },
    "curbside_discount": {
      "type": "boolean",
      "default": false
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "record_type": {
      "type": "string",
      "enum": [
        "service",
        "internal_test"
      ],
      "default": "service"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "none",
        "paid",
        "refunded"
      ],
      "default": "none"
    },
    "notified": {
      "type": "object",
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "contacted",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "accepted",
        "declined",
        "completed"
      ],
      "default": "unassigned"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "job_value": {
      "type": "number"
    },
    "payout_paid": {
      "type": "boolean",
      "default": false
    },
    "review_requested": {
      "type": "boolean",
      "default": false
    },
    "calendar_event_id": {
      "type": "string",
      "default": ""
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "phone",
    "address",
    "items_description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}