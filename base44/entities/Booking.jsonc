{
  "name": "Booking",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "province_code": {
      "type": "string",
      "default": ""
    },
    "pickup_lat": {
      "type": "number",
      "description": "Verified latitude of the confirmed pickup location. Set only from real geocoding or the customer's own map adjustment \u2014 never inferred or invented."
    },
    "pickup_lng": {
      "type": "number",
      "description": "Verified longitude of the confirmed pickup location. One authoritative location record per booking."
    },
    "pickup_unit": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Apartment or unit number the customer entered. Never geocoded or inferred."
    },
    "pickup_location_source": {
      "type": "string",
      "enum": [
        "verified_geocode",
        "customer_adjusted"
      ],
      "default": "",
      "description": "How the pickup coordinates were established. Empty = coordinates not captured."
    },
    "access_notes": {
      "type": "object",
      "default": {},
      "description": "Customer's job-preparation answers for the contractor brief (items inside/outside, stairs, elevator, parking, heavy items, note). Never inferred from map imagery."
    },
    "items_description": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "time_window": {
      "type": "string"
    },
    "quote_estimate": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string",
      "format": "uri"
    },
    "curbside_discount": {
      "type": "boolean",
      "default": false
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "record_type": {
      "type": "string",
      "enum": [
        "service",
        "internal_test"
      ],
      "default": "service"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "none",
        "paid",
        "paid_externally",
        "refunded"
      ],
      "default": "none"
    },
    "external_payment_method": {
      "type": "string",
      "default": "",
      "description": "How an externally paid booking was settled, entered by the owner (cash, e-transfer, contractor POS...). Empty for platform payments."
    },
    "external_payment_note": {
      "type": "string",
      "default": "",
      "maxLength": 500,
      "description": "Owner's free-text note about the external payment. Never part of financial accounting records."
    },
    "external_payment_verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the owner has reconciled the external payment against the books. Unverified external payments are excluded from collected platform revenue."
    },
    "reconcile_reminder": {
      "type": "boolean",
      "default": false,
      "description": "Optional reminder: flag an externally paid job for financial reconciliation later."
    },
    "reconcile_reminder_date": {
      "type": "string",
      "format": "date",
      "description": "Date the reconciliation reminder becomes due. Only used when reconcile_reminder is true."
    },
    "notified": {
      "type": "object",
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "contacted",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "new"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "reference_code": {
      "type": "string",
      "default": "",
      "description": "8-character public tracking code shown to the customer for status lookup."
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "accepted",
        "scheduled",
        "completed",
        "declined",
        "paid"
      ],
      "default": "unassigned"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "job_value": {
      "type": "number"
    },
    "final_invoice": {
      "type": "number",
      "default": 0
    },
    "approved_quote_amount": {
      "type": "number",
      "default": 0,
      "description": "Customer-approved price for the original scope. 0 = not yet approved."
    },
    "approval_method": {
      "type": "string",
      "default": "",
      "description": "How the original quote was approved: on_site, secure_link, chat or phone."
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "When the customer approved the original quote."
    },
    "referred_by_admin": {
      "type": "boolean",
      "default": false
    },
    "commission_rate": {
      "type": "number",
      "default": 0
    },
    "commission_earned": {
      "type": "number",
      "default": 0
    },
    "commission_paid": {
      "type": "number",
      "default": 0
    },
    "commission_paid_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_confirmed": {
      "type": "boolean",
      "default": false
    },
    "payout_paid": {
      "type": "boolean",
      "default": false
    },
    "review_requested": {
      "type": "boolean",
      "default": false
    },
    "calendar_event_id": {
      "type": "string",
      "default": ""
    },
    "followup_count": {
      "type": "number",
      "default": 0
    },
    "last_followup_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_status": {
      "type": "string",
      "enum": [
        "",
        "on_time",
        "late",
        "no_show"
      ],
      "default": "",
      "description": "Arrival punctuality for the job window, recorded at completion. Empty = not yet recorded."
    },
    "receipt_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the customer's receipt (Recycling Impact Report) has been generated and sent."
    },
    "receipt_sent_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "customer_origin_source": {
      "type": "string",
      "enum": [
        "contractor_generated",
        "platform_generated",
        "personal_referral",
        "other_referral"
      ],
      "description": "How the customer was FIRST acquired. Set once, never rewritten."
    },
    "job_source": {
      "type": "string",
      "enum": [
        "contractor_generated",
        "platform_generated",
        "personal_referral",
        "repeat_customer",
        "other_referral"
      ],
      "description": "Where THIS job came from (can differ from the customer's original source)."
    },
    "agreement_id": {
      "type": "string",
      "default": "",
      "description": "ContractorAgreement applied to this job at assignment time."
    },
    "fee_terms_snapshot": {
      "type": "object",
      "default": {},
      "description": "Fee terms disclosed to the contractor when the job was assigned."
    },
    "platform_fee_amount": {
      "type": "number",
      "default": 0
    },
    "contractor_net_amount": {
      "type": "number",
      "default": 0
    },
    "refund_amount": {
      "type": "number",
      "default": 0
    },
    "sid": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "description": "Anonymous browser-session key linking this booking to its originating visit (traffic source, country, service viewed) and any quote request in the same session."
    }
  },
  "required": [
    "name",
    "phone",
    "address",
    "items_description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}