{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "description": "Home base city (primary territory)."
    },
    "province_code": {
      "type": "string",
      "default": "",
      "description": "Province or territory code (BC, ON, QC, NT...) for national operations and tax handling."
    },
    "territory_type": {
      "type": "string",
      "enum": [
        "single_city",
        "multi_city",
        "metro_region"
      ],
      "default": "single_city",
      "description": "Shape of the confirmed service area: one municipality, several municipalities, or a full metropolitan region."
    },
    "service_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Additional municipalities the contractor explicitly confirmed they serve, beyond their home city. Set by the contractor or the admin \u2014 never inferred from geographic proximity. One operator covering many cities stays a single record."
    },
    "territory_verified_date": {
      "type": "string",
      "format": "date",
      "description": "When the service area was last confirmed by the contractor or admin."
    },
    "truck_capacity": {
      "type": "number",
      "default": 1,
      "description": "Trucks (or equivalent full crews) this contractor can run per day. Measured separately from coverage."
    },
    "same_day_capable": {
      "type": "boolean",
      "default": false,
      "description": "Contractor explicitly confirmed same-day fulfillment capability. A city can be covered without same-day being guaranteed."
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "limited",
        "unavailable"
      ],
      "default": "available",
      "description": "Current dispatch availability, separate from coverage and capacity."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Job types this contractor handles (junk_removal, furniture, appliances, electronics, metal_pickup, cleanouts, other). Empty means they handle every type."
    },
    "dispatch_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual_only"
      ],
      "default": "auto",
      "description": "auto = the dispatcher automatically offers matching jobs; manual_only = only the admin assigns jobs."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "business_number": {
      "type": "string",
      "default": "",
      "maxLength": 30,
      "description": "CRA business number (or registration number) of the contractor's business. Used to keep one operator on one record across municipalities."
    },
    "tax_registered": {
      "type": "string",
      "enum": [
        "unknown",
        "gst_registered",
        "not_registered"
      ],
      "default": "unknown",
      "description": "Whether the contractor is registered to charge sales tax (GST/HST account). Unknown until they confirm."
    },
    "coi_uri": {
      "type": "string",
      "format": "uri",
      "default": "",
      "description": "Private-storage URI of the contractor's liability insurance certificate (COI)."
    },
    "coi_expiry": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the liability insurance policy on the COI. Empty = not on file."
    },
    "credentials": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Applicable provincial or municipal credentials (WCB/WorkSafe clearance, commercial disposal accounts...)."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "email",
    "city"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}