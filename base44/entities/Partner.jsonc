{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string"
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Job types this contractor handles (junk_removal, furniture, appliances, electronics, metal_pickup, cleanouts, other). Empty means they handle every type."
    },
    "dispatch_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual_only"
      ],
      "default": "auto",
      "description": "auto = the dispatcher automatically offers matching jobs; manual_only = only the admin assigns jobs."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "email",
    "city"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}