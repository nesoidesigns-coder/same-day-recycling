{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string"
    },
    "province_code": {
      "type": "string",
      "default": "",
      "description": "Province or territory code (BC, ON, QC, NT...) for national operations and tax handling."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Job types this contractor handles (junk_removal, furniture, appliances, electronics, metal_pickup, cleanouts, other). Empty means they handle every type."
    },
    "dispatch_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual_only"
      ],
      "default": "auto",
      "description": "auto = the dispatcher automatically offers matching jobs; manual_only = only the admin assigns jobs."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "business_number": {
      "type": "string",
      "default": "",
      "maxLength": 30,
      "description": "CRA business number (or registration number) of the contractor's business."
    },
    "tax_registered": {
      "type": "string",
      "enum": [
        "unknown",
        "gst_registered",
        "not_registered"
      ],
      "default": "unknown",
      "description": "Whether the contractor is registered to charge sales tax (GST/HST account). Unknown until they confirm."
    },
    "coi_uri": {
      "type": "string",
      "format": "uri",
      "default": "",
      "description": "Private-storage URI of the contractor's liability insurance certificate (COI)."
    },
    "coi_expiry": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the liability insurance policy on the COI. Empty = not on file."
    },
    "credentials": {
      "type": "string",
      "default": "",
      "maxLength": 1000,
      "description": "Applicable provincial or municipal credentials (WCB/WorkSafe clearance, commercial disposal accounts...)."
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "email",
    "city"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}