{
  "name": "CommunityReport",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "post",
        "comment",
        "profile",
        "opportunity"
      ],
      "default": "post"
    },
    "target_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harassment",
        "misleading",
        "fraudulent_posting",
        "other"
      ],
      "default": "other"
    },
    "details": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "actioned",
        "dismissed"
      ],
      "default": "open"
    },
    "resolution_note": {
      "type": "string",
      "default": "",
      "maxLength": 1000
    }
  },
  "required": [
    "target_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}